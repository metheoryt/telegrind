/local/*
!/local/.gitkeep
.env
.env.prod
compose.override.yml
google-account.json
.idea/
.venv/
**/__pycache__

# Gortex: auto-generated routing skills (re-sprayed by a bare `gortex init`)
.claude/skills/generated/
# Claude Code machine-local settings
.claude/settings.local.json

# Project memory lives in the agent-memory repo (~/.claude/memory/projects/
# metheoryt/telegrind/); .claude/memory is a symlink to it. No trailing slash: a
# `/`-suffixed pattern does not match a symlink.
.claude/memory

# Harvest state lives outside the repo: the watermark and review proposals in
# agent-memory (projects/metheoryt/telegrind/harvest/), run backups in
# ~/.local/state/memory-harvest/.
.claude/harvest
.claude/kb-harvest-state.json

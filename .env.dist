# Copy to .env and fill in.
# For local dev, run ./dev-setup.sh instead — it generates a .env with sane defaults.

# --- Postgres (compose 'postgres' service) ---
POSTGRES_PASSWORD=

# App DB URL. 'postgres' is the compose service hostname; asyncpg is the runtime driver.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@postgres/postgres

# --- Telegram ---
BOT_TOKEN=

# --- LLM ---
# Model used for normal extraction.
LLM_MODEL=claude-haiku-4-5
# Stronger model. NOT WIRED UP: nothing reads this yet. Kept because the
# knob is wanted for a future retry-on-a-bigger-model path, not because
# setting it changes anything today.
LLM_MODEL_ESCALATE=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- The Claude meta layer (optional) ---
# Comma-separated Telegram chat ids allowed to talk to Claude. UNSET MEANS
# OFF: the bot still records, classifies and reacts, and a question it
# cannot answer says so instead of being handed over. The gate is on the
# chat, not on the verdict — `talk` from a stranger is not answered at all.
#
# The allowlist is on the CHAT id, not on from_user.id. In a private chat
# the two are the same number; name a GROUP here and every member of that
# group drives Claude.
CLAUDE_ADMIN_CHAT_IDS=
# Where the `claude` CLI lives, and what directory a turn runs in. On dev,
# run the bot on the HOST (`uv run python main.py`), not in the container:
# the image has no claude binary and no ~/.claude.
CLAUDE_BIN=claude
# SET THIS TO A SCRATCH CHECKOUT BEFORE THE FIRST `talk` MESSAGE.
#
# Left empty, cwd falls back to the bot's own working directory — so
# started with `uv run python main.py` from the repo root, the first talk
# message runs full Claude Code (your CLAUDE.md, skills, hooks and MCP
# servers) under `--permission-mode bypassPermissions
# --permission-prompts none` IN THE CHECKOUT YOU ARE WORKING IN,
# uncommitted work and all. The spec's rule that Claude never edits the
# live tree is about production; dev is where this runs first.
#
#     git worktree add /tmp/claude-sandbox HEAD
#     CLAUDE_CWD=/tmp/claude-sandbox
#
# Shipped empty rather than with a placeholder path on purpose: a
# directory that does not exist fails inside create_subprocess_exec and
# reads as a broken `claude` binary.
CLAUDE_CWD=
# Seconds before a hung turn is given up on and said out loud.
CLAUDE_TURN_TIMEOUT=600

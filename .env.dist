# Copy to .env and fill in.
# For local dev, run ./dev-setup.sh instead — it generates a .env with sane defaults.

# --- Postgres (compose 'postgres' service) ---
POSTGRES_PASSWORD=

# App DB URL. 'postgres' is the compose service hostname; asyncpg is the runtime driver.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@postgres/postgres

# --- Telegram ---
BOT_TOKEN=

# --- LLM ---
# Model used for normal extraction.
LLM_MODEL=claude-haiku-4-5
# Stronger model. NOT WIRED UP: nothing reads this yet. Kept because the
# knob is wanted for a future retry-on-a-bigger-model path, not because
# setting it changes anything today.
LLM_MODEL_ESCALATE=claude-sonnet-5
ANTHROPIC_API_KEY=
